{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$(git rev-parse --show-toplevel)\" && python3 tools/session_start.py",
            "statusMessage": "ローカル変更を保護して同期を確認中...",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$(git rev-parse --show-toplevel)\" && python3 tools/operations_check.py",
            "statusMessage": "変更を検査中（自動送信なし）...",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
