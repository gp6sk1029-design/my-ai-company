# 認証情報・秘密鍵（絶対にアップロード禁止）
blog/google_credentials.json
blog/google_token.pickle
blog/config.json
ec/config.json
tools/ec/config.json
*.pickle

# 環境設定ファイル
.env
.env.local
*.secret

# macOS
.DS_Store
**/.DS_Store

# Python
__pycache__/
*.pyc
*.pyo

# 画像・メディアファイル
blog/images/processed/
blog/images/characters/
ec/data/temp_photos/
tools/ec/data/temp_photos/

# Chromeプロファイル（大容量）
ec/data/mercari_chrome/
tools/ec/data/mercari_chrome/

# DBファイル
*.db

# 一時ファイル
*.tmp
*.log

# Git同期エラー通知用
.claude/.push_failed
.claude/.push_error

# blog-capture（ブログ素材転送ツール）
blog/images/raw/
blog/apps-script/**/.clasp.json
blog/apps-script/**/.clasprc.json
blog/apps-script/**/node_modules/
.clasprc.json

# Obsidian（2026-06-16導入）
# volatileな作業状態・キャッシュは除外（毎回変わり競合の元になる）
.obsidian/workspace.json
.obsidian/workspace-mobile.json
.obsidian/cache
.obsidian/plugins/*/data.json
.trash/
# 安定設定（appearance.json/core-plugins.json/app.json 等）はコミットして2台目PCへ配る
